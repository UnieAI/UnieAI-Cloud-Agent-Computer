# CAC single-host bundle. Copy to .env next to docker-compose.yml.

# ── Object store (required): any S3 API ─────────────────────────────────────
# Bundled SeaweedFS (docker compose --profile bundled-s3 up -d):
S3_ENDPOINT=http://seaweedfs:8333
# Your own store instead, e.g.  http://minio.internal:9000  or  https://s3.us-east-1.amazonaws.com
S3_BUCKET=cac
# For the bundled store, pick any (openssl rand -hex 16 / -hex 32); for your own, its keys.
# Letters and digits only for the bundled store: they are written into its JSON config.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# true for SeaweedFS and MinIO; false only for a store that refuses path-style URLs.
S3_FORCE_PATH_STYLE=true

# ── Callers ─────────────────────────────────────────────────────────────────
# One entry per application that calls CAC. Only the key's sha256 is stored:
#   key=$(openssl rand -hex 32); printf %s "$key" | sha256sum
CAC_CALLERS=[{"id":"studio","namespace":"studio","key_sha256":"<sha256 of the key>"}]
# The legacy shared token (copilot-v2). Leave empty unless that caller exists.
SANDBOX_INTERNAL_TOKEN=

# ── Sandboxes ───────────────────────────────────────────────────────────────
# The template image every sandbox runs (docker/sandbox-template builds a generic one).
SANDBOX_DOCKER_IMAGE=cac-sandbox:local
# Sandboxes run as this uid, which also owns every file in /workspace. It must be
# a uid NO host account has (the owner of a tenant's files can read them from the
# host), so never 1000 on a stock Ubuntu host, and never 0. Your own template image
# should give it a passwd entry and a home; cac-sandbox:local uses 2468.
# SANDBOX_HOST_MOUNT_S3_UID=2468
SANDBOX_DEFAULT_MEMORY_MB=2048
SANDBOX_DEFAULT_CPUS=2
SANDBOX_POOL_TOTAL_MAX=8

# ── Host ────────────────────────────────────────────────────────────────────
CAC_PORT=4020
CAC_MOUNT_ROOT=/var/lib/cac/mnt
# Explicit subnets: a busy Docker host can run out of default address pools.
CAC_STORE_SUBNET=10.89.0.0/24
CAC_SANDBOX_SUBNET=10.89.1.0/24
